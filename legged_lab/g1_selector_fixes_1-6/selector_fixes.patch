+        OMP_NUM_THREADS="1",
+        MKL_NUM_THREADS="1",
+    )
+
+    def run(script, *args, accepted=(0,)):
+        result = subprocess.run(
+            [
+                sys.executable,
+                str(root / "legged_lab/scripts" / script),
+                *map(str, args),
+            ],
+            env=env,
+            capture_output=True,
+            text=True,
+            timeout=60,
+        )
+        assert result.returncode in accepted, result.stdout + result.stderr
+        return result
