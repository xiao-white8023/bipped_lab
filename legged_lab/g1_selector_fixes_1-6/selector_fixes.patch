+                labels,
+                [groups[split]] * 32,
+                torch.zeros(32),
+                torch.full((32,), index),
+                torch.arange(32) + index * 32,
+                candidate_time=timestamp,
+                feature_end_time=timestamp,
+                execution_metadata=torch.zeros(32, 3),
+            )
+        )
+    writer.close()
+    env = dict(
