+def test_cpu_training_evaluation_export_and_artifact_contract(tmp_path):
+    root = Path(__file__).parents[2]
+    dataset, models, exports = (
+        tmp_path / "dataset",
+        tmp_path / "models",
+        tmp_path / "exported",
