<mujoco model="g1 gaps scene">
  <!-- 包含带 motor actuator 的机器人模型 -->
  <include file="g1_23dof_rev_1_0.xml"/>

  <statistic center="3 0 0.5" extent="5.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="pit_checker" builtin="checker" mark="edge" rgb1="0.12 0.16 0.18" rgb2="0.08 0.11 0.13" markrgb="0.45 0.5 0.55" width="300" height="300"/>
    <material name="pit_floor" texture="pit_checker" texuniform="true" texrepeat="8 4" reflectance="0.05"/>
    <material name="platform" rgba="0.42 0.44 0.46 1" specular="0" reflectance="0.0"/>
  </asset>

  <worldbody>
    <light pos="3 0 3" dir="0 0 -1" directional="true"/>
    
    <!-- 
    坑洞场景配置:
    - 机器人初始化高度: 0.793m (pelvis)
    - 平台顶面高度: 0 (与正常地面齐平)
    - 沟壑深度: 0.5m (掉下去会摔)
    - 单个沟壑宽度: 0.35m (x=1.50 到 x=1.85)
    -->
    
    <!-- 起始平台 (机器人初始化位置 x=0, y=0) -->
    <geom name="start_platform" type="box" size="1.5 5.0 0.25" pos="0 0 -0.25" material="platform" friction="1.0 0.005 0.0001"/>
    
    <!-- 单个沟壑: 起始平台右边缘 x=1.50, 终点平台左边缘 x=1.85 -->
    <geom name="end_platform" type="box" size="4.0 5.0 0.25" pos="5.85 0 -0.25" material="platform" friction="1.0 0.005 0.0001"/>
    
    <!-- 底部地面 (沟壑底部，掉下去会落到这里) -->
    <geom name="floor" size="20 10 0.01" type="box" pos="5 0 -0.51" material="pit_floor" friction="1.0 0.005 0.0001"/>
    
  </worldbody>
</mujoco>
