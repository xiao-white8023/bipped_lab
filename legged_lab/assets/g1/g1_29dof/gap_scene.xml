<mujoco model="g1 20cm gap scene">
  <include file="g1_29dof_rev_1_0.xml"/>

  <statistic center="1.6 0 0.5" extent="4.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="gap_groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="gap_groundplane" texture="gap_groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="gap_platform" rgba="0.5 0.5 0.6 1"/>
  </asset>

  <worldbody>
    <light pos="2 0 3" dir="0 0 -1" directional="true"/>

    <!-- Two level platforms with a 0.20 m gap along the x axis. -->
    <!-- left_platform max x = 1.50, right_platform min x = 1.70, gap = 0.20 m. -->
    <geom name="left_platform" type="box" size="1.5 5.0 0.25" pos="0.0 0 -0.25" material="gap_platform" friction="1.0 0.005 0.0001"/>
    <geom name="right_platform" type="box" size="1.5 5.0 0.25" pos="3.2 0 -0.25" material="gap_platform" friction="1.0 0.005 0.0001"/>

    <!-- Catch floor below the gap so a fall is visible without filling the top gap. -->
    <geom name="bottom_floor" type="box" size="5.0 5.0 0.01" pos="1.6 0 -0.51" material="gap_groundplane" friction="1.0 0.005 0.0001"/>
  </worldbody>
</mujoco>
