+        return s["history"]/cfg.vp_depth_max_m, s["history_support"], s["last_source"], s["last_packet"]
+
+    def audit(self, plan):
+        s = self.state
+        values = (
+            plan.lp_strength, plan.vp_strength, s["bias_m"], s["scale_error"], s["edge_mix"],
